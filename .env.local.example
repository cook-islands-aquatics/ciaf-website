# Sanity CMS — get these from sanity.io/manage
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id_here
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity API token — needed for draft previews (optional for basic setup)
SANITY_API_TOKEN=

# Resend email API key — for contact form (optional; falls back to mailto)
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@cookislandsaquatics.org
NEXT_PUBLIC_FB_APP_ID=